<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const prog = (el: HTMLElement) => clamp(-el.getBoundingClientRect().top / (el.offsetHeight - innerHeight));

  // History story
  const story = document.querySelector<HTMLElement>(".v4 .story")!;
  const beats = [...story.querySelectorAll<HTMLElement>(".beat")];
  const ticks = [...story.querySelectorAll<HTMLElement>(".ticks li")];
  const notes = [...story.querySelectorAll<HTMLElement>(".beat-notes span")].map((s) => s.textContent || "");
  const note = story.querySelector<HTMLElement>(".art-note")!;
  let cur = -1;
  const setBeat = (b: number) => {
    if (b === cur) return; cur = b; story.dataset.b = String(b);
    beats.forEach((el, i) => el.classList.toggle("on", i === b));
    ticks.forEach((el, i) => el.classList.toggle("on", i <= b));
    note.textContent = notes[b];
  };

  // Temperature
  const temp = document.querySelector<HTMLElement>(".v4 .temp")!;
  const tstage = temp.querySelector<HTMLElement>(".t-stage")!;
  const tvid = temp.querySelector<HTMLElement>(".t-vid")!;
  const tnum = document.getElementById("tnum")!;
  const steps = [...temp.querySelectorAll<HTMLElement>(".t-step")];
  const mix = (a: number[], b: number[], t: number) => a.map((v, i) => Math.round(v + (b[i] - v) * t));
  const HEAT = [210, 96, 47], COOL = [126, 154, 173], GR = [28, 29, 28], PAPER = [236, 235, 230], LIGHT = [237, 237, 232], INK = [22, 22, 22];
  const drawTemp = () => {
    const p = reduce ? 1 : prog(temp);
    const k = clamp(p / 0.28);                 // draw kiln curve
    const d = clamp((p - 0.3) / 0.4);          // temperature drop
    const e = d * d * (3 - 2 * d);
    const T = Math.round(1400 - 1150 * e);
    tnum.textContent = T.toLocaleString("en-US");
    tstage.style.setProperty("--dk", String(1 - k));
    tstage.style.setProperty("--do", String(1 - clamp((p - 0.38) / 0.35)));
    tstage.style.setProperty("--lk", String(k));
    tstage.style.setProperty("--lo", String(clamp((p - 0.6) / 0.15)));
    tstage.style.setProperty("--tc", `rgb(${mix(HEAT, COOL, e).join(",")})`);
    tstage.style.backgroundColor = `rgb(${mix(GR, PAPER, clamp((e - 0.55) / 0.45)).join(",")})`;
    tstage.style.color = `rgb(${mix(LIGHT, INK, clamp((e - 0.55) / 0.45)).join(",")})`;
    tstage.style.setProperty("--cbg", String(0.55 * (1 - clamp((e - 0.4) / 0.4))));
    tvid.style.opacity = String(0.34 * (1 - e));
    const s = p < 0.3 ? 0 : p < 0.72 ? 1 : 2;
    steps.forEach((el, i) => el.classList.toggle("on", i === s));
  };

  const onScroll = () => {
    setBeat(Math.min(beats.length - 1, Math.floor(prog(story) * beats.length)));
    drawTemp();
  };
  addEventListener("scroll", onScroll, { passive: true }); addEventListener("resize", onScroll); onScroll();

  // Pause offscreen videos to save battery
  const vids = [...document.querySelectorAll<HTMLVideoElement>(".v4 video")];
  const io = new IntersectionObserver((es) => es.forEach((e) => { const v = e.target as HTMLVideoElement; if (e.isIntersecting) { if (!reduce) v.play().catch(() => {}); } else v.pause(); }), { rootMargin: "100px" });
  vids.forEach((v) => { if (reduce) v.removeAttribute("autoplay"); io.observe(v); });

  const nav = document.getElementById("cardnav")!;
  const btn = nav.querySelector("button")!;
  btn.addEventListener("click", () => { const o = !nav.classList.contains("open"); nav.classList.toggle("open", o); btn.setAttribute("aria-expanded", String(o)); });
  nav.querySelectorAll("nav a").forEach((a) => a.addEventListener("click", () => { nav.classList.remove("open"); btn.setAttribute("aria-expanded", "false"); }));
</script>
