---
// Variant B · Editorial. Light bone paper, Newsreader serif headline, dark grains.
import Landing from "../../layouts/Landing.astro";
const email = "teresa@ourosmaterials.com";
---
<Landing noindex theme="#ECEBE6">
  <canvas id="field" class="field" aria-hidden="true"></canvas>
  <div class="b">
    <header>
      <a href="/" class="logo"><img src="/brand/ouros-logo-primary-black.svg" alt="Ouros Materials" /></a>
      <a href={`mailto:${email}`} class="contact">Contact</a>
    </header>
    <main>
      <h1>Rebuilding America’s <em>materials frontier.</em></h1>
      <p>Advanced ceramics, reinvented. A new class of ceramic composites made below 250°C, for American energy, defense and infrastructure.</p>
    </main>
    <footer class="mono"><span>Ouros Materials</span><span>New Brunswick, New Jersey</span></footer>
  </div>
  <style is:global>
    body { background: #ECEBE6; color: #161718; font-family: Inter, Helvetica, Arial, sans-serif; }
    .b { position: fixed; inset: 0; display: grid; grid-template-rows: auto 1fr auto; grid-template-columns: minmax(0, 1fr); padding: clamp(22px, 3vw, 40px); }
    .b header, .b footer { display: flex; justify-content: space-between; align-items: center; animation: fade 1.6s .3s both; }
    .b .logo { line-height: 0; } .b .logo img { height: 34px; }
    .b .contact { font-size: 15px; border-bottom: 1px solid #161718; padding-bottom: 2px; }
    .b main { align-self: end; justify-self: center; text-align: center; max-width: 1000px; padding-bottom: 5vh; }
    .b h1 { margin: 0; font-family: Newsreader, Georgia, serif; font-weight: 380; font-size: clamp(44px, 6.4vw, 104px); line-height: .98; letter-spacing: -.025em; animation: up 1.4s cubic-bezier(.2,.7,.2,1) both; }
    .b h1 em { font-style: italic; font-weight: 340; }
    .b p { margin: 26px auto 0; max-width: 520px; font-size: 16px; line-height: 1.55; color: #55595B; animation: up 1.4s .2s cubic-bezier(.2,.7,.2,1) both; }
    .b footer { font-size: 11px; letter-spacing: .06em; color: #6A6E70; }
    @media (max-width: 760px) {
      .b .logo img { height: 28px; }
      .b main { padding-bottom: 3vh; }
      .b h1 { font-size: 46px; }
      .b p { font-size: 15px; }
    }
  </style>
  <script>
    import { startPowder } from "../../scripts/powder";
    startPowder({ bg: "#ECEBE6", grain: [22, 23, 24], accent: false, marks: false, alpha: 0.9, desk: { x: 0.5, y: 0.33, s: 0.24 }, mob: { x: 0.5, y: 0.3, s: 0.17 } });
  </script>
</Landing>
