---
// Variant C · Drawing sheet. Inset frame with tick marks and an engineering title block.
import Landing from "../../layouts/Landing.astro";
const email = "teresa@ourosmaterials.com";
---
<Landing noindex theme="#111213">
  <canvas id="field" class="field" aria-hidden="true"></canvas>
  <div class="c">
    <div class="sheet"></div>
    <a class="logo" href="/"><img src="/brand/ouros-logo-primary-white.svg" alt="Ouros Materials" /></a>
    <h1>Advanced ceramics,<br />reinvented.</h1>
    <table class="tb mono" aria-label="Company details">
      <tr><th>Ouros Materials</th><td>Advanced ceramic composites</td></tr>
      <tr><th>Form</th><td><span id="c-n">01/04</span> · <span id="c-form">Tile</span></td></tr>
      <tr><th>Process</th><td>Below 250°C</td></tr>
      <tr><th>Location</th><td>New Brunswick, NJ</td></tr>
      <tr><th>Contact</th><td><a href={`mailto:${email}`}>{email}</a></td></tr>
    </table>
  </div>
  <style is:global>
    body { background: #111213; color: #E6E7E7; font-family: Inter, Helvetica, Arial, sans-serif; }
    .c { position: fixed; inset: 0; --m: clamp(14px, 1.8vw, 24px); }
    .c .sheet { position: absolute; inset: var(--m); border: 1px solid rgba(230,231,231,.18); pointer-events: none; animation: fade 1.2s both;
      background:
        repeating-linear-gradient(90deg, rgba(230,231,231,.28) 0 1px, transparent 1px 80px) top left / 100% 7px no-repeat,
        repeating-linear-gradient(90deg, rgba(230,231,231,.28) 0 1px, transparent 1px 80px) bottom left / 100% 7px no-repeat,
        repeating-linear-gradient(180deg, rgba(230,231,231,.28) 0 1px, transparent 1px 80px) top left / 7px 100% no-repeat,
        repeating-linear-gradient(180deg, rgba(230,231,231,.28) 0 1px, transparent 1px 80px) top right / 7px 100% no-repeat; }
    .c .logo { position: absolute; top: calc(var(--m) + 26px); left: calc(var(--m) + 28px); line-height: 0; animation: fade 1.6s .2s both; }
    .c .logo img { height: 32px; }
    .c h1 { position: absolute; left: calc(var(--m) + 28px); top: 50%; transform: translateY(-50%); margin: 0; font-weight: 400; font-size: clamp(40px, 5.4vw, 84px); line-height: .98; letter-spacing: -.04em; animation: fade 1.6s .1s both; }
    .c .tb { position: absolute; right: var(--m); bottom: var(--m); width: 520px; border-collapse: collapse; font-size: 10.5px; letter-spacing: .05em; color: #A6AAAD; background: #111213; animation: fade 1.6s .5s both; }
    .c .tb th, .c .tb td { border: 1px solid rgba(230,231,231,.18); padding: 8px 12px; text-align: left; font-weight: 400; white-space: nowrap; }
    .c .tb th { color: #6F7477; width: 1%; }
    .c .tb tr:first-child th { color: #E6E7E7; }
    .c .tb a:hover { color: #fff; }
    @media (max-width: 760px) {
      .c .logo img { height: 26px; }
      .c h1 { top: auto; bottom: calc(var(--m) + 196px); transform: none; font-size: 36px; }
      .c .tb { left: var(--m); width: auto; font-size: 9.5px; }
      .c .tb th, .c .tb td { padding: 7px 9px; white-space: normal; }
    }
  </style>
  <script>
    import { startPowder } from "../../scripts/powder";
    const n = document.getElementById("c-n")!, f = document.getElementById("c-form")!;
    startPowder({ bg: "#111213", accent: false, desk: { x: 0.68, y: 0.44, s: 0.28 }, mob: { x: 0.5, y: 0.3, s: 0.18 },
      onPhase: (i) => { n.textContent = `0${i.n}/0${i.total}`; f.textContent = i.name; } });
  </script>
</Landing>
