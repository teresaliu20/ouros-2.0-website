---
// Variant D · Monumental. Geist sans, a full-width headline set along the bottom edge.
import Landing from "../../layouts/Landing.astro";
const email = "teresa@ourosmaterials.com";
---
<Landing noindex>
  <canvas id="field" class="field" aria-hidden="true"></canvas>
  <div class="d">
    <header>
      <a href="/" class="logo"><img src="/brand/ouros-logo-primary-white.svg" alt="Ouros Materials" /></a>
      <p>Rebuilding America’s<br />materials frontier.</p>
      <a href={`mailto:${email}`} class="contact">{email}</a>
    </header>
    <div class="row mono"><span>Ceramic composites made below 250°C</span><span>New Brunswick, NJ</span></div>
    <h1>Advanced ceramics, reinvented.</h1>
  </div>
  <style is:global>
    body { background: #0B0C0D; color: #EDEEEE; font-family: Geist, Inter, Helvetica, Arial, sans-serif; }
    .d { position: fixed; inset: 0; display: flex; flex-direction: column; padding: clamp(22px, 3vw, 40px) clamp(22px, 3vw, 40px) 0; }
    .d header { display: grid; grid-template-columns: 1fr 1fr 1fr; align-items: start; gap: 20px; animation: fade 1.6s .3s both; }
    .d .logo { line-height: 0; } .d .logo img { height: 34px; }
    .d header p { margin: 0; font-size: 15px; line-height: 1.35; color: #A9ADB0; letter-spacing: -.01em; }
    .d .contact { justify-self: end; font-size: 15px; color: #C4C7C9; } .d .contact:hover { color: #fff; }
    .d .row { margin-top: auto; display: flex; justify-content: space-between; font-size: 11px; letter-spacing: .06em; color: #7D8184; border-top: 1px solid rgba(237,238,238,.14); padding-top: 12px; animation: fade 1.6s .5s both; }
    .d h1 { margin: 0 0 -.12em; font-weight: 500; font-size: 7.05vw; line-height: 1.04; letter-spacing: -.055em; white-space: nowrap; animation: up 1.5s cubic-bezier(.2,.7,.2,1) both; }
    @media (max-width: 760px) {
      .d header { grid-template-columns: 1fr auto; }
      .d header p { grid-row: 2; grid-column: 1 / -1; }
      .d .logo img { height: 28px; }
      .d .contact { font-size: 13px; }
      .d .row { flex-direction: column; gap: 6px; }
      .d h1 { white-space: normal; font-size: 17vw; line-height: .94; margin-bottom: 18px; margin-top: 10px; }
    }
  </style>
  <script>
    import { startPowder } from "../../scripts/powder";
    startPowder({ accent: false, marks: false, desk: { x: 0.62, y: 0.4, s: 0.26 }, mob: { x: 0.5, y: 0.36, s: 0.17 } });
  </script>
</Landing>
