  .v2 .ph { aspect-ratio: 4 / 5; background: #dddbd3; border-radius: 4px; display: flex; align-items: flex-end; padding: 14px; font-family: Newsreader, Georgia, serif; font-size: 44px; color: #b9b7ad; }
  .v2 .people h3, .v2 .adv h3 { margin: 14px 0 0; font-size: 24px; }
  .v2 .role { margin: 2px 0 8px; color: var(--mute); font-size: 14.5px; }
  .v2 .people article p:last-child, .v2 .adv article p:last-child { margin: 0; font-size: 15px; }
