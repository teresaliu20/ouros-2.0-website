  .v2 .btn { display: inline-block; margin-top: 32px; border: 1px solid #EDEDE8; color: #EDEDE8; text-decoration: none; padding: 13px 18px; border-radius: 3px; font-size: 15px; }
  .v2 .foot-row { margin-top: 88px; display: flex; gap: 28px; flex-wrap: wrap; font-size: 14.5px; color: #9a9a93; border-top: 1px solid #3a3b39; padding-top: 18px; }
  .v2 .foot-row a { color: #EDEDE8; text-decoration: none; }
  .v2 .foot-word { display: block; width: calc(100% - 2 * clamp(20px, 4vw, 48px)); margin: 72px auto 64px; height: auto; }
</style>
<script>
  const story = document.querySelector<HTMLElement>(".v2 .story")!;
  const beats = [...story.querySelectorAll<HTMLElement>(".beat")];
  const ticks = [...story.querySelectorAll<HTMLElement>(".ticks li")];
  const notes = [...story.querySelectorAll<HTMLElement>(".beat-notes span")].map((s) => s.textContent || "");
  const note = story.querySelector<HTMLElement>(".art-note")!;
  let cur = -1;
  const set = (b: number) => {
    if (b === cur) return; cur = b;
    story.dataset.b = String(b);
    beats.forEach((el, i) => el.classList.toggle("on", i === b));
    ticks.forEach((el, i) => el.classList.toggle("on", i <= b));
    note.textContent = notes[b];
  };
  const onScroll = () => {
    const r = story.getBoundingClientRect();
    const span = story.offsetHeight - window.innerHeight;
    const p = Math.min(1, Math.max(0, -r.top / span));
    set(Math.min(beats.length - 1, Math.floor(p * beats.length)));
  };
  addEventListener("scroll", onScroll, { passive: true }); addEventListener("resize", onScroll); onScroll();

  const nav = document.getElementById("cardnav")!;
  const btn = nav.querySelector("button")!;
  btn.addEventListener("click", () => { const o = !nav.classList.contains("open"); nav.classList.toggle("open", o); btn.setAttribute("aria-expanded", String(o)); });
  nav.querySelectorAll("nav a").forEach((a) => a.addEventListener("click", () => { nav.classList.remove("open"); btn.setAttribute("aria-expanded", "false"); }));
</script>
</Version>
