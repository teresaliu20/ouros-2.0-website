---
// Aligned-style scene: dark isometric wireframe of the planned Foundry line, with speckle, a sweeping
// scan ring, floating station labels, travelling tiles and a live HUD. Concept drawing, not a photo.
import { projection, scaffold, boxEdges, plate, ring, speckle, line, poly, bounds, f } from "./iso";

const P = projection(18, 42, 5.2);
const L = 172, Dp = 46;
const pl = plate(P, 0, 0, L, Dp, 8);
const conv = boxEdges(P, 3, 20, 0, L - 6, 6, 5);
let rollers = "";
for (let x = 5; x < L - 4; x += 3) rollers += line(P, [x, 20, 5], [x, 26, 5]);
const stations = [
  { x: 14, n: "01", t: "Dispense" }, { x: 46, n: "02", t: "Press" }, { x: 78, n: "03", t: "Cure <250°C" },
  { x: 110, n: "04", t: "Scan" }, { x: 142, n: "05", t: "Test" },
].map((s, i) => {
  const w = 20, y = 10, d = 26, h = 22;
  const lat = scaffold(P, s.x, y, 0, w, d, h, 4, 3, 4);
  let inner = "";
  if (i === 0) inner = poly(P, [[s.x + 6, 17, 18], [s.x + 14, 17, 18], [s.x + 10, 23, 10]]) + poly(P, [[s.x + 14, 17, 18], [s.x + 14, 27, 18], [s.x + 10, 23, 10]]);
  if (i === 1) { const e = boxEdges(P, s.x + 7, 19, 9, 6, 8, 11); inner = e.vis + e.hid; }
  if (i === 2) { const e = boxEdges(P, s.x + 3, 15, 5, 14, 16, 12); inner = e.vis + e.hid; }
  if (i === 3) inner = line(P, [s.x + 4, 23, 19], [s.x + 16, 23, 19]) + line(P, [s.x + 10, 23, 19], [s.x + 10, 23, 6]);
  if (i === 4) { const e = boxEdges(P, s.x + 5, 17, 5, 10, 12, 7); inner = e.vis + e.hid; }
  const lab = P(s.x + w / 2, y, h + 3);
  const pts = speckle(P, s.x, y, 0, w, d, h, 60, 7 + i * 13);
  const blip = P(s.x + w / 2, 23, 5.5);
  return { ...s, lat, inner, lab, pts, blip };
});
const tile = poly(P, [[0, 0, 0], [3.2, 0, 0], [3.2, 3.2, 0], [0, 3.2, 0]]);
const t0 = P(2, 21.4, 5.3), t1 = P(L - 6, 21.4, 5.3);
const tilePath = `M${f(t0[0])} ${f(t0[1])} L${f(t1[0])} ${f(t1[1])}`;
const floorPts = speckle(P, 0, 0, 0, L, Dp, 0.2, 260, 99);
const rc = P(L / 2, 23, 0);
const scan = ring(P, L / 2, 23, 0, 46);
const b = bounds(P, [[0, 0, 0], [L, 0, 0], [0, Dp, 0], [L, Dp, 0], [0, 0, 26], [L, 0, 26]], 30);
---
<figure class="fscene" aria-label="Concept drawing of the planned Ouros Foundry line: five stations (dispense, press, cure below 250°C, scan, test) along a conveyor">
  <div class="hud tl"><span>Ouros Foundry · concept</span><span>Staged roadmap, not yet built</span></div>
  <div class="hud tr"><span>UTC <b class="utc">00:00:00</b></span><span>Stations <b>05</b> · Max temp <b>250°C</b></span></div>
  <i class="crop c1"></i><i class="crop c2"></i><i class="crop c3"></i><i class="crop c4"></i>
  <svg viewBox={`${b.x} ${b.y} ${b.w} ${b.h}`} role="img">
    <g class="floor"><path d={pl.grid} class="grid" /><path d={pl.edge} class="edge" />
      {floorPts.map(([x, y]) => <circle cx={x} cy={y} r=".7" class="sp dim" />)}
    </g>
    <g class="scanwrap" style={`transform-origin:${f(rc[0])}px ${f(rc[1])}px`}><path d={scan} class="scan" /></g>
    <g class="draw d0"><path d={conv.hid} class="w hid" pathLength="1" /><path d={conv.vis} class="w" pathLength="1" /><path d={rollers} class="w thin" pathLength="1" /></g>
    {stations.map((s, i) => (
      <g class={`draw d${i + 1}`}>
        <path d={s.lat} class="w lat" pathLength="1" />
        <path d={s.inner} class="w inner" pathLength="1" />
        {s.pts.map(([x, y]) => <circle cx={x} cy={y} r=".8" class="sp" />)}
        <circle cx={s.blip[0]} cy={s.blip[1]} r="2.2" class="blip" style={`animation-delay:${i * 0.7}s`} />
      </g>
    ))}
    <g class="tiles">
      {Array.from({ length: 7 }, (_, k) => (
        <path d={tile} class="tile"><animateMotion dur="16s" repeatCount="indefinite" begin={`${-k * 2.3}s`} path={tilePath} /></path>
      ))}
    </g>
    {stations.map((s, i) => (
      <g class={`lab l${i}`} transform={`translate(${f(s.lab[0])} ${f(s.lab[1])})`}>
        <line x1="0" y1="0" x2="0" y2="-16" class="leader" />
        <rect x={-(s.t.length * 3.6 + 22)} y="-34" width={s.t.length * 7.2 + 44} height="18" rx="2" class="tag" />
        <text x="0" y="-21.5" class="tt">{s.n} · {s.t}</text>
      </g>
    ))}
  </svg>
</figure>
<style is:global>
  .fscene { position: relative; margin: 0; background: #161716; border: 1px solid #2c2d2b; border-radius: 6px; overflow: hidden; aspect-ratio: 16 / 8; }
  .fscene svg { position: absolute; inset: 5% 2% 2%; width: 96%; height: 93%; overflow: visible; }
  .fscene .grid { fill: none; stroke: #e8e8e2; stroke-opacity: .07; stroke-width: .8; }
  .fscene .edge { fill: rgba(255,255,255,.015); stroke: #e8e8e2; stroke-opacity: .25; stroke-width: .9; }
  .fscene .w { fill: none; stroke: #e6e6df; stroke-width: .8; stroke-opacity: .7; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 2.4s cubic-bezier(.4,.1,.2,1); }
  .fscene .w.lat { stroke-opacity: .45; } .fscene .w.thin { stroke-opacity: .35; } .fscene .w.hid { stroke-opacity: .2; } .fscene .w.inner { stroke-opacity: .85; stroke-width: 1; }
  .fscene.in .w { stroke-dashoffset: 0; }
  .fscene.in .d1 .w { transition-delay: .25s; } .fscene.in .d2 .w { transition-delay: .5s; } .fscene.in .d3 .w { transition-delay: .75s; } .fscene.in .d4 .w { transition-delay: 1s; } .fscene.in .d5 .w { transition-delay: 1.25s; }
  .fscene .sp { fill: #f2f2ec; opacity: 0; transition: opacity 1.2s ease 1.6s; } .fscene .sp.dim { fill: #9a9a93; }
  .fscene.in .sp { opacity: .55; } .fscene.in .sp.dim { opacity: .35; }
  .fscene .blip { fill: #fff; opacity: 0; }
  .fscene.in .blip { animation: fblip 2.8s ease-in-out infinite; }
  @keyframes fblip { 0%, 100% { opacity: .15; } 50% { opacity: 1; } }
  .fscene .tile { fill: #f4f4ef; fill-opacity: .9; stroke: #fff; stroke-width: .5; opacity: 0; transition: opacity 1s ease 2.4s; }
  .fscene.in .tile { opacity: 1; }
  .fscene .scan { fill: none; stroke: #C6CF7C; stroke-width: 1.4; vector-effect: non-scaling-stroke; }
  .fscene .scanwrap { opacity: 0; }
  .fscene.in .scanwrap { animation: fscan 6s cubic-bezier(.3,.1,.3,1) 2.6s infinite; }
  @keyframes fscan { 0% { transform: scale(.08); opacity: 0; } 12% { opacity: .9; } 80% { opacity: .5; } 100% { transform: scale(1.55); opacity: 0; } }
  .fscene .lab { opacity: 0; transition: opacity .6s ease; }
  .fscene.in .lab { opacity: 1; } .fscene.in .l0 { transition-delay: 1.8s; } .fscene.in .l1 { transition-delay: 2s; } .fscene.in .l2 { transition-delay: 2.2s; } .fscene.in .l3 { transition-delay: 2.4s; } .fscene.in .l4 { transition-delay: 2.6s; }
  .fscene .leader { stroke: #e6e6df; stroke-opacity: .5; stroke-width: .8; }
  .fscene .tag { fill: #0f100f; stroke: #3a3b39; stroke-width: .8; }
  .fscene .tt { fill: #ededE7; font: 500 9.5px Inter, sans-serif; text-anchor: middle; letter-spacing: .01em; }
  .fscene .hud { position: absolute; z-index: 2; display: flex; flex-direction: column; gap: 3px; font: 500 10.5px GeistMono, monospace; letter-spacing: .08em; text-transform: uppercase; color: #8d8d86; }
  .fscene .hud b { color: #e8e8e2; font-weight: 500; }
  .fscene .hud.tl { top: 18px; left: 22px; } .fscene .hud.tr { top: 18px; right: 22px; text-align: right; }
  .fscene .crop { position: absolute; width: 12px; height: 12px; border: 0 solid #5a5b57; }
  .fscene .c1 { left: 8px; top: 8px; border-width: 1px 0 0 1px; } .fscene .c2 { right: 8px; top: 8px; border-width: 1px 1px 0 0; }
  .fscene .c3 { left: 8px; bottom: 8px; border-width: 0 0 1px 1px; } .fscene .c4 { right: 8px; bottom: 8px; border-width: 0 1px 1px 0; }
  @media (max-width: 760px) { .fscene { aspect-ratio: 4 / 3.4; } .fscene svg { inset: 16% 0 8% -9%; width: 118%; height: 76%; } .fscene .hud { font-size: 8.5px; } .fscene .hud.tr { top: auto; bottom: 14px; } .fscene .hud.tl span:last-child { display: none; } }
  @media (prefers-reduced-motion: reduce) { .fscene .w { transition: none; } .fscene.in .scanwrap, .fscene.in .blip { animation: none; } .fscene .tiles { display: none; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>(".fscene").forEach((el) => {
    new IntersectionObserver((es, o) => es.forEach((e) => { if (e.isIntersecting) { el.classList.add("in"); o.disconnect(); } }), { threshold: 0.3 }).observe(el);
    const utc = el.querySelector<HTMLElement>(".utc");
    const tick = () => { if (utc) utc.textContent = new Date().toISOString().slice(11, 19); };
    tick(); setInterval(tick, 1000);
  });
</script>
