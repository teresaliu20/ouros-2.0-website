---
// Landing page body (Editorial). Options: caption (form name + temperature counter), rotator
// (cycling italic line), interactive (cursor/touch scatters grains), second (a second scroll screen).
import Landing from "../layouts/Landing.astro";
interface Props { subtext: string; caption?: boolean; rotator?: string[]; interactive?: boolean; second?: boolean; noindex?: boolean }
const { subtext, caption = false, rotator, interactive = false, second = false, noindex = false } = Astro.props;
const email = "teresa@ourosmaterials.com";
---
<Landing theme="#ECEBE6" noindex={noindex}>
  <script is:inline>
    // Runs before paint so there is no flash. Sun elevation from the visitor's clock and an
    // approximate longitude from their UTC offset; refined after load with IP location (/api/geo).
    window.ourosSun = function (lat, lon, t) {
      var r = Math.PI / 180, d = (t || Date.now()) / 864e5 - 10957.5;
      var g = (357.529 + 0.98560028 * d) * r, q = 280.459 + 0.98564736 * d;
      var L = (q + 1.915 * Math.sin(g) + 0.02 * Math.sin(2 * g)) * r, e = (23.439 - 3.6e-7 * d) * r;
      var ra = Math.atan2(Math.cos(e) * Math.sin(L), Math.cos(L)), dec = Math.asin(Math.sin(e) * Math.sin(L));
      var ha = ((18.697374558 + 24.06570982441908 * d) * 15 + lon) * r - ra;
      return Math.asin(Math.sin(lat * r) * Math.sin(dec) + Math.cos(lat * r) * Math.cos(dec) * Math.cos(ha)) / r;
    };
    window.ourosTheme = function (lat, lon) {
      var q = new URLSearchParams(location.search).get("theme");
      if (q === "day" || q === "night") return q;
      return window.ourosSun(lat, lon) > -4 ? "day" : "night";
    };
    document.documentElement.dataset.theme = window.ourosTheme(40, -new Date().getTimezoneOffset() / 4);
  </script>
  <canvas id="field" class="field" aria-hidden="true"></canvas>
  <div class="b" data-caption={caption ? "1" : undefined} data-rotator={rotator ? JSON.stringify(rotator) : undefined} data-interactive={interactive ? "1" : undefined} data-second={second ? "1" : undefined}>
    <header>
      <a href="/" class="logo">
        <img class="day" src="/brand/ouros-logo-primary-black.svg" alt="Ouros Materials" />
        <img class="night" src="/brand/ouros-logo-primary-white.svg" alt="" aria-hidden="true" />
      </a>
      <nav class="links mono"><a href="https://www.linkedin.com/company/98473484/" target="_blank" rel="noopener">LinkedIn</a><a href={`mailto:${email}`}>Contact</a></nav>
    </header>
    <main>
      {caption && <div class="cap mono" aria-hidden="true"><span><b id="cap-n">01/04</b> <span id="cap-form">Tile</span></span><span>Kiln 1,000°C → Ouros <b id="cap-t">—</b></span></div>}
      <h1>Rebuilding America’s <br /><em>materials frontier.</em></h1>
      {rotator && <div class="rot" aria-live="polite"><em id="rot">{rotator[0]}</em></div>}
      <p>{subtext}</p>
    </main>
    <footer class="mono"><span>More coming soon</span><span>New York, New York</span></footer>
  </div>
  {second && (
    <section class="s2">
      <h2>Every era of American progress was built on a new material. <span>Steel, aluminum, nylon, fiberglass, the transistor, optical fiber. Then the labs that made them were broken up, and the factories moved overseas.</span></h2>
      <div class="pillars">
        <div><b class="mono">01 · Materials</b><p>Advanced ceramic hybrids: fire-resistant, tough, and machinable like wood.</p></div>
        <div><b class="mono">02 · Process</b><p>A proprietary process that forms ceramics at roughly one-eighth the temperature of a conventional kiln.</p></div>
        <div><b class="mono">03 · Foundry</b><p>AI, robotics and automated hardware to take new materials from lab to factory, in America.</p></div>
      </div>
      <footer class="mono"><span>More coming soon</span><a href={`mailto:${email}`}>teresa@ourosmaterials.com</a></footer>
    </section>
  )}
  <style is:global>
    :root { --bg: #ECEBE6; --fg: #161718; --mid: #55595B; --dim: #6A6E70; --corner: #96999B; }
    :root[data-theme="night"] { --bg: #0E0F10; --fg: #E9E8E3; --mid: #A3A6A8; --dim: #7D8184; --corner: #8B8F92; }
    body { background: var(--bg); color: var(--fg); font-family: Inter, Helvetica, Arial, sans-serif; transition: background-color 1.2s ease, color 1.2s ease; }
    .b { position: fixed; inset: 0; display: grid; grid-template-rows: auto 1fr auto; grid-template-columns: minmax(0, 1fr); padding: clamp(22px, 3vw, 40px); }
    .b header, .b footer { display: flex; justify-content: space-between; align-items: center; animation: fade 1.6s .3s both; }
    .b .logo { line-height: 0; display: grid; } .b .logo img { height: 34px; grid-area: 1 / 1; transition: opacity 1.2s ease; }
    .b .logo .night, :root[data-theme="night"] .b .logo .day { opacity: 0; }
    :root[data-theme="night"] .b .logo .night { opacity: 1; }
    .b .links { display: flex; gap: 28px; }
    .b .links a:hover { color: var(--fg); }
    .b main { align-self: end; justify-self: center; text-align: center; max-width: 1000px; padding-bottom: 5vh; }
    .b h1 { margin: 0; font-family: Newsreader, Georgia, serif; font-weight: 380; font-size: clamp(44px, 6.4vw, 104px); line-height: .98; letter-spacing: -.025em; animation: up 1.4s cubic-bezier(.2,.7,.2,1) both; }
    .b h1 em { font-style: italic; font-weight: 340; }
    .b p { margin: 26px auto 0; max-width: 600px; font-size: 16px; line-height: 1.55; color: var(--mid); transition: color 1.2s ease; animation: up 1.4s .2s cubic-bezier(.2,.7,.2,1) both; }
    .b .cap { display: flex; justify-content: center; gap: 28px; font-size: 11px; font-weight: 700; letter-spacing: .06em; color: var(--corner); margin-bottom: 22px; transition: color 1.2s ease; animation: fade 1.6s .6s both; }
    .b .cap b { color: var(--fg); font-weight: 700; transition: color 1.2s ease; }
    .b .rot { margin-top: 14px; font-family: Newsreader, Georgia, serif; font-size: clamp(22px, 2.2vw, 32px); color: var(--mid); height: 1.3em; animation: up 1.4s .15s cubic-bezier(.2,.7,.2,1) both; }
    .b .rot em { display: inline-block; font-style: italic; transition: opacity .5s ease, transform .5s ease; }
    .b .rot em.out { opacity: 0; transform: translateY(8px); }
    .b[data-second] { position: absolute; height: 100svh; }
    body:has(.b[data-second]) { overflow-y: auto; overflow-x: hidden; } body:has(.b[data-second]) canvas.field { position: absolute; height: 100svh; }
    .s2 { position: relative; margin-top: 100svh; padding: clamp(80px, 12vh, 140px) clamp(22px, 3vw, 40px) clamp(22px, 3vw, 40px); border-top: 1px solid color-mix(in srgb, var(--fg) 12%, transparent); }
    .s2 h2 { margin: 0 auto; max-width: 1080px; text-align: center; font-family: Newsreader, Georgia, serif; font-weight: 380; font-size: clamp(30px, 3.6vw, 56px); line-height: 1.08; letter-spacing: -.02em; }
    .s2 h2 span { color: var(--mid); }
    .s2 .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 48px); max-width: 1080px; margin: clamp(60px, 9vh, 110px) auto; }
    .s2 .pillars b { display: block; font-size: 11px; letter-spacing: .06em; color: var(--corner); border-top: 1px solid color-mix(in srgb, var(--fg) 14%, transparent); padding-top: 14px; }
    .s2 .pillars p { margin: 14px 0 0; font-size: 16px; line-height: 1.5; color: var(--mid); }
    .s2 footer { display: flex; justify-content: space-between; font-size: 11px; font-weight: 700; letter-spacing: .06em; color: var(--corner); }
    @media (max-width: 760px) { .s2 .pillars { grid-template-columns: 1fr; } .b .cap { gap: 16px; margin-bottom: 14px; } .b .rot { font-size: 21px; margin-top: 10px; } }
    /* All corner text: Geist Mono bold, uppercase, one light grey. */
    .b .links, .b footer { font-size: 11px; font-weight: 700; letter-spacing: .06em; color: var(--corner); transition: color 1.2s ease; }
    .b .links a { transition: color .3s ease; }
    @media (max-height: 780px) and (min-width: 761px) {
      .b h1 { font-size: clamp(40px, 5.4vw, 84px); }
      .b main { padding-bottom: 2vh; }
    }
    @media (max-width: 760px) {
      .b .logo img { height: 28px; }
      .b .links { gap: 18px; }
      .b p { font-size: 14px !important; margin-top: 18px; }
      .b main { padding-bottom: 3vh; }
      .b h1 { font-size: 46px; }
      .b p { font-size: 15px; }
    }
  </style>
  <script>
    import { startPowder } from "../scripts/powder";
    type Theme = "day" | "night";
    const W = window as any, root = document.documentElement;
    const PAL = {
      day: { bg: "#ECEBE6", grain: [22, 23, 24] as [number, number, number], alpha: 0.9 },
      night: { bg: "#0E0F10", grain: [222, 224, 225] as [number, number, number], alpha: 1 },
    };
    const start = PAL[root.dataset.theme as Theme] ?? PAL.day;
    const B = (document.querySelector(".b") as HTMLElement).dataset;
    const rot: string[] | null = B.rotator ? JSON.parse(B.rotator) : null;
    const $ = (id: string) => document.getElementById(id);
    let lastN = 0;
    const powder = startPowder({ bg: start.bg, grain: start.grain, alpha: start.alpha, accent: false, marks: false,
      desk: { x: 0.5, y: 0.3, s: 0.21 }, mob: { x: 0.5, y: 0.29, s: 0.16 }, interactive: !!B.interactive,
      zone: () => {
        const h = document.querySelector(".b header")?.getBoundingClientRect(), t = (document.querySelector(".b .cap") ?? document.querySelector(".b h1"))?.getBoundingClientRect();
        return h && t ? { top: h.bottom + 12, bottom: t.top - 16 } : null;
      },
      onPhase: (i) => {
        if (B.caption) { $("cap-n")!.textContent = `0${i.n}/0${i.total}`; $("cap-form")!.textContent = i.name; }
        if (rot && i.phase === "Consolidating" && i.n !== lastN) {
          lastN = i.n; const el = $("rot")!; el.classList.add("out");
          setTimeout(() => { el.textContent = rot[(i.n - 1) % rot.length]; el.classList.remove("out"); }, 450);
        }
      },
      onProgress: (_u, phase, pull) => {
        if (!B.caption) return;
        const ease = (t: number) => (t <= 0 ? 0 : t >= 1 ? 1 : t * t * (3 - 2 * t));
        let txt = "—";
        if (phase === "Consolidating") { const v = Math.round((1000 - 750 * ease(pull)) / 10) * 10; txt = v.toLocaleString("en-US") + "°C"; }
        else if (phase === "Formed") txt = "<250°C";
        else if (phase === "Releasing") txt = "<250°C";
        const el = $("cap-t")!; if (el.textContent !== txt) el.textContent = txt;
      } });
    document.fonts?.ready.then(() => dispatchEvent(new Event("resize")));

    let lat = 40, lon = -new Date().getTimezoneOffset() / 4;
    const apply = () => {
      const t: Theme = W.ourosTheme(lat, lon);
      if (root.dataset.theme !== t) root.dataset.theme = t;
      const p = PAL[t];
      powder.setColors(p.bg, p.grain, p.alpha);
      document.querySelector('meta[name="theme-color"]')?.setAttribute("content", p.bg);
    };
    apply();
    // Refine with the visitor's approximate location (city-level, from Vercel's IP headers; nothing stored).
    fetch("/api/geo").then((r) => (r.ok ? r.json() : null)).then((g) => {
      if (g && Number.isFinite(g.lat) && Number.isFinite(g.lon)) { lat = g.lat; lon = g.lon; apply(); }
    }).catch(() => {});
    setInterval(apply, 5 * 60 * 1000);
  </script>
</Landing>
