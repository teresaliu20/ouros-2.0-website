{
  "redirects": [
    {
      "source": "/press",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#g-contact",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/deck",
      "destination": "/api/deck"
    },
    {
      "source": "/deck/logout",
      "destination": "/api/deck?action=logout"
    },
    {
      "source": "/deck-teaser",
      "destination": "/api/teaser"
    },
    {
      "source": "/deck-teaser/logout",
      "destination": "/api/teaser?action=logout"
    },
    {
      "source": "/deck-impact",
      "destination": "/api/impact"
    },
    {
      "source": "/deck-impact/logout",
      "destination": "/api/impact?action=logout"
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
